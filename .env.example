# =============================================================================
# .env — configurare unificată pentru toate serviciile
# Copiază în .env și completează valorile reale
# =============================================================================

# Profiluri active (combină cu virgulă)
# Opțiuni: streamlit, django, lotus, calibre, cops
COMPOSE_PROFILES=django,lotus,cops

# -----------------------------------------------------------------------------
# INFRASTRUCTURĂ
# -----------------------------------------------------------------------------
DUCKDNS_TOKEN=your-duckdns-token

# Calea absolută spre biblioteca Calibre (conține metadata.db + cărți)
BOOKS_PATH=/home/ubuntu/books

# UID/GID pentru containere linuxserver (ubuntu = 1000)
PUID=1000
PGID=1000

# -----------------------------------------------------------------------------
# BAZĂ DE DATE (Supabase — comună tuturor aplicațiilor)
# -----------------------------------------------------------------------------
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASS=your-db-password
DB_HOST=aws-0-eu-central-1.pooler.supabase.com
DB_PORT=5432

# -----------------------------------------------------------------------------
# DJANGO STOC (stoc.incercari.duckdns.org)
# -----------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=stoc.incercari.duckdns.org,localhost,127.0.0.1

# -----------------------------------------------------------------------------
# LOTUS RESTAURANT (lotus.incercari.duckdns.org)
# -----------------------------------------------------------------------------
LOTUS_SECRET_KEY=change-me-to-another-random-secret-key
LOTUS_DEBUG=False
LOTUS_ALLOWED_HOSTS=lotus.incercari.duckdns.org,localhost,127.0.0.1
LOTUS_AUTH_ENABLED=True
