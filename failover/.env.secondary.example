# .env.secondary.example — variabile SUPLIMENTARE pentru serverul secundar
# Adaugă-le în același .env ca și configurația principală

# ── Failover script ──────────────────────────────────────────────────────────
# IP-ul serverului primar (static, nu DuckDNS)
PRIMARY_IP=1.2.3.4

# Hostname de verificat pentru health check (via curl cu IP forțat)
PRIMARY_HOSTNAME=stoc.incercari.duckdns.org

# Domenii DuckDNS de actualizat la failover (fără spații)
DUCKDNS_DOMAINS=incercari

# Webhook opțional pentru notificări (Slack, Discord, etc.)
# WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ── Sync certificate (pe PRIMAR) ─────────────────────────────────────────────
# Adaugă în .env de pe PRIMAR:
SECONDARY_HOST=5.6.7.8
SECONDARY_USER=ubuntu
REMOTE_PATH=/opt/stoc/letsencrypt
